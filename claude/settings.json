{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "awaySummaryEnabled": false,
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git push --force-with-lease*)",
      "Bash(git push --atomic --force-with-lease*)",
      "Bash(mise exec -- git push --force-with-lease*)",
      "Bash(mise exec -- git push --atomic --force-with-lease*)",
      "Bash(mise exec -- git push --atomic origin --force-with-lease*)"
    ]
  }
}
