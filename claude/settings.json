{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "awaySummaryEnabled": false,
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git push --force-with-lease*)",
      "Bash(git push --atomic --force-with-lease*)",
      "Bash(mise exec -- git push --force-with-lease*)",
      "Bash(mise exec -- git push --atomic --force-with-lease*)",
      "Bash(mise exec -- git push --atomic origin --force-with-lease*)",
      "Bash(gh pr view*)",
      "Bash(mise exec -- gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(mise exec -- gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(mise exec -- gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(mise exec -- gh pr checks*)",
      "Bash(gh run view*)",
      "Bash(mise exec -- gh run view*)",
      "Bash(gh run list*)",
      "Bash(mise exec -- gh run list*)",
      "Bash(gh issue view*)",
      "Bash(mise exec -- gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(mise exec -- gh issue list*)",
      "Bash(gh repo view*)",
      "Bash(mise exec -- gh repo view*)",
      "Bash(gh search*)",
      "Bash(mise exec -- gh search*)",
      "Bash(gh pr edit*)",
      "Bash(mise exec -- gh pr edit*)",
      "Bash(gh api*)",
      "Bash(mise exec -- gh api*)",
      "Bash(gh pr create*)",
      "Bash(mise exec -- gh pr create*)",
      "Bash(gh pr comment*)",
      "Bash(mise exec -- gh pr comment*)",
      "Bash(gh pr ready*)",
      "Bash(mise exec -- gh pr ready*)"
    ]
  }
}
