{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "awaySummaryEnabled": false,
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git push --force-with-lease*)",
      "Bash(git push --atomic --force-with-lease*)",
      "Bash(mise exec -- git push --force-with-lease*)",
      "Bash(mise exec -- git push --atomic --force-with-lease*)",
      "Bash(mise exec -- git push --atomic origin --force-with-lease*)",
      "Bash(gh *)",
      "Bash(mise exec -- gh *)"
    ],
    "deny": [
      "Bash(gh repo delete*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo rename*)",
      "Bash(gh repo edit*--visibility*)",
      "Bash(gh release delete*)",
      "Bash(gh secret*)",
      "Bash(gh variable*)",
      "Bash(gh ssh-key*)",
      "Bash(gh gpg-key*)",
      "Bash(mise exec -- gh repo delete*)",
      "Bash(mise exec -- gh repo archive*)",
      "Bash(mise exec -- gh repo rename*)",
      "Bash(mise exec -- gh repo edit*--visibility*)",
      "Bash(mise exec -- gh release delete*)",
      "Bash(mise exec -- gh secret*)",
      "Bash(mise exec -- gh variable*)",
      "Bash(mise exec -- gh ssh-key*)",
      "Bash(mise exec -- gh gpg-key*)"
    ]
  }
}
